# =========================
# API
# =========================
OPENDATA_API_URL=https://public.opendatasoft.com/api/explore/v2.1/catalog/datasets/evenements-publics-openagenda/records

# (optionnel si un jour nécessaire)
OPENAGENDA_API_KEY=

# =========================
# PÉRIMÈTRE GÉOGRAPHIQUE
# =========================
COUNTRY=FR
REGION=Hauts-de-France
DEPARTMENT=Nord
CITY=Lille


# =========================
# FILTRE TEMPOREL
# =========================
HISTORY_YEARS=1
INCLUDE_FUTURE=true

# =========================
# MISTRAL (utilisé pour RAG)
# =========================
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# Modèle d'embeddings utilisé pour la vectorisation.
MISTRAL_EMBEDDING_MODEL=mistral-embed
# Modèle utilisé par Ragas pour l'évaluation (facultatif).
MISTRAL_EVAL_MODEL=mistral-large-latest
# =========================
# VECTOR STORE & CHUNKING
# =========================
FAISS_INDEX_PATH=data/faiss_index
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
# Nombre de chunks remontés par la recherche vectorielle.
RETRIEVER_K=10
# Nombre maximum d'événements uniques injectés dans le prompt.
MAX_CONTEXT_EVENTS=20
# =========================
# INGESTION OPENAGENDA
# =========================
# Timeout HTTP en secondes pour les appels OpenAgenda.
OPENDATA_TIMEOUT=60
# Garde-fou : nombre maximum d'événements récupérés par /rebuild.
MAX_EVENTS=1000